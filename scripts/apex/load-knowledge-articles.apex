// GENERATED by scripts/build-knowledge-apex.mjs from knowledge/*.md.
// Do not edit by hand: change the Markdown, then run `npm run build:knowledge`.
//
// Creates and publishes the 8 knowledge articles. Safe to re-run:
// an article that is already online with the same text is left alone, and one
// whose text changed is republished as a new version.
//
// Each article's text goes in the standard Summary field, so no custom field
// is needed. Point the agent's knowledge source at Title and Summary.
//
// Needs Lightning Knowledge turned on and the Knowledge User checkbox on the
// running user.
// Run:  sf apex run --file scripts/apex/load-knowledge-articles.apex

List<List<String>> articles = new List<List<String>>{
    new List<String>{
        'ascent-45-backpack',
        'Ascent 45 Backpack: Fit and Capacity',
        'The Ascent 45 holds 45 liters, enough for one to three nights on the trail. The pack weighs 3 lb 4 oz.\n\nIt fits torso lengths from 16 to 21 inches. Move the shoulder harness up or down to match yours. The hip belt should sit on top of your hip bones and carry most of the weight.\n\nIt includes a rain cover, stored in the bottom pocket, and a sleeve for a hydration reservoir of up to 3 liters.'
    },
    new List<String>{
        'final-sale-items',
        'Final Sale Items',
        'Items sold at clearance prices are marked final sale on the product page and on your order.\n\nFinal sale items cannot be returned, exchanged, or refunded.\n\nIf you are not sure whether an item is final sale, give us your order number and the email address on the order, and we will check it for you.'
    },
    new List<String>{
        'granite-hiking-boots',
        'Granite Hiking Boots: Fit and Care',
        'The Granite Hiking Boots are mid-height leather boots with a waterproof, breathable membrane and a lugged rubber outsole.\n\nThey run true to size. If you are between sizes, choose the larger size to leave room for thick hiking socks.\n\nWear them around the house for a few days before a long hike, so they can break in.\n\nTo clean them, brush off dried mud, rinse with lukewarm water, and let them air dry away from direct heat. Treat the leather with a waterproofing conditioner every few months.'
    },
    new List<String>{
        'order-status-meanings',
        'What Your Order Status Means',
        'Processing: we received your order and are getting it ready to ship.\n\nShipped: your order has left our warehouse. The expected delivery date is the carrier\'s estimate.\n\nDelivered: the carrier marked your order as delivered. If you cannot find it, check around your home and with neighbors, then contact us within 7 days.\n\nCancelled: the order was cancelled. You were not charged, or your refund is on its way.\n\nTo check an order, give us your order number, which starts with RO-, and the email address on the order. For your privacy, we share order details only when both match.'
    },
    new List<String>{
        'return-policy',
        'Return Policy',
        'You can return most items within 30 days of the delivery date. Items must be unused, with the original tags and packaging.\n\nThe 30 days start on the day your order is delivered. An order that has not been delivered yet cannot be returned yet.\n\nItems marked final sale cannot be returned.\n\nTo start a return, give us your order number and the email address on the order. We check the order, open a return case, and give you the case number. We email a prepaid return label within one business day.\n\nReturn shipping is free if the item arrived damaged or is not what you ordered. Otherwise, we deduct a $6.95 label fee from your refund.\n\nOnce your return reaches our warehouse, we refund your original payment method within 5 to 7 business days.'
    },
    new List<String>{
        'shipping-options',
        'Shipping Options and Delivery Times',
        'We ship to addresses in the United States only.\n\nOrders leave our warehouse within 1 to 2 business days.\n\nStandard shipping takes 5 to 7 business days. It is free on orders over $75, and $5.95 otherwise.\n\nExpedited shipping takes 2 to 3 business days and costs $14.95.\n\nYou get a tracking email when your order ships. Delivery dates are estimates and can slip during holidays and severe weather.'
    },
    new List<String>{
        'summit-2-tent',
        'Summit 2 Tent: Specs and Setup',
        'The Summit 2 Tent sleeps two people. It is a three-season, freestanding tent that weighs 4 lb 2 oz with stakes and rainfly.\n\nIt has two doors and two vestibules for storing packs and boots.\n\nSetup takes about 10 minutes: clip the tent body to the two color-coded poles, then drape the rainfly over and buckle it at each corner.\n\nIt is not designed for snow loads or winter camping. Always dry the tent fully before you store it, to prevent mildew.'
    },
    new List<String>{
        'talking-to-a-person',
        'Talking to a Person',
        'You can ask to talk to a person at any time, and we will connect you with our customer care team.\n\nOur team is available Monday to Friday, 8 a.m. to 6 p.m. Eastern Time. Outside those hours, we reply by email within one business day.\n\nIf a product caused an injury, damaged property, or raised a safety concern, we connect you with a person right away. Please stop using the product until we have spoken with you.'
    }
};

Set<String> urlNames = new Set<String>();
for (List<String> a : articles) {
    urlNames.add(a[0]);
}

Map<String, Knowledge__kav> online = new Map<String, Knowledge__kav>();
for (Knowledge__kav k : [
    SELECT Id, KnowledgeArticleId, UrlName, Title, Summary
    FROM Knowledge__kav
    WHERE PublishStatus = 'Online' AND UrlName IN :urlNames
]) {
    online.put(k.UrlName, k);
}
Map<String, Knowledge__kav> drafts = new Map<String, Knowledge__kav>();
for (Knowledge__kav k : [
    SELECT Id, KnowledgeArticleId, UrlName, Title, Summary
    FROM Knowledge__kav
    WHERE PublishStatus = 'Draft' AND UrlName IN :urlNames
]) {
    drafts.put(k.UrlName, k);
}

Integer created = 0;
Integer updated = 0;
Integer unchanged = 0;
for (List<String> a : articles) {
    String urlName = a[0];
    String title = a[1];
    String summary = a[2];
    Knowledge__kav live = online.get(urlName);
    Knowledge__kav draft = drafts.get(urlName);

    // String.equals is case-sensitive; == on Apex Strings is not.
    if (draft == null && live != null && title.equals(live.Title) && summary.equals(live.Summary)) {
        unchanged++;
        continue;
    }

    Id knowledgeArticleId;
    if (draft != null) {
        // A draft is left over from an earlier run or an edit: finish it.
        draft.Title = title;
        draft.Summary = summary;
        update draft;
        knowledgeArticleId = draft.KnowledgeArticleId;
        updated++;
    } else if (live != null) {
        Id draftId = KbManagement.PublishingService.editOnlineArticle(live.KnowledgeArticleId, false);
        update new Knowledge__kav(Id = draftId, Title = title, Summary = summary);
        knowledgeArticleId = live.KnowledgeArticleId;
        updated++;
    } else {
        Knowledge__kav fresh = new Knowledge__kav(Title = title, UrlName = urlName, Summary = summary);
        insert fresh;
        knowledgeArticleId = [SELECT KnowledgeArticleId FROM Knowledge__kav WHERE Id = :fresh.Id].KnowledgeArticleId;
        created++;
    }
    KbManagement.PublishingService.publishArticle(knowledgeArticleId, true);
}

System.debug('Knowledge articles: ' + created + ' created, ' + updated + ' updated, ' + unchanged + ' unchanged.');
