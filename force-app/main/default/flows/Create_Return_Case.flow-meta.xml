<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Set_Result</name>
        <label>Set Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>created</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>caseNumber</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Created_Case.CaseNumber</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Inputs_Present</name>
        <label>Inputs Present?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Missing Input</defaultConnectorLabel>
        <rules>
            <name>Both_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inputsPresent</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Order</targetReference>
            </connector>
            <label>Both Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Order_Verified</name>
        <label>Order Verified?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Verified</defaultConnectorLabel>
        <rules>
            <name>Order_Matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Order</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Case</targetReference>
            </connector>
            <label>Order Matches</label>
        </rules>
    </decisions>
    <description>Opens a return case for the agent. Re-checks that the order number and the email on the order match. On a match it creates a Case and returns the case number with created = true. Otherwise it returns created = false and opens no case. It does not decide whether a return is allowed: the agent must check the return policy, final sale, and delivery date first.</description>
    <environments>Default</environments>
    <formulas>
        <name>caseDescription</name>
        <dataType>String</dataType>
        <expression>&quot;Return reason: &quot; &amp; {!reason}</expression>
    </formulas>
    <formulas>
        <name>caseSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Return request: &quot; &amp; {!Get_Order.Order_Number__c} &amp; &quot; - &quot; &amp; {!Get_Order.Item__c}</expression>
    </formulas>
    <formulas>
        <name>emailClean</name>
        <dataType>String</dataType>
        <expression>TRIM({!customerEmail})</expression>
    </formulas>
    <formulas>
        <name>inputsPresent</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK(TRIM({!orderNumber}))) &amp;&amp; NOT(ISBLANK(TRIM({!customerEmail})))</expression>
    </formulas>
    <formulas>
        <name>orderNumberClean</name>
        <dataType>String</dataType>
        <expression>UPPER(TRIM({!orderNumber}))</expression>
    </formulas>
    <interviewLabel>Create Return Case {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Return Case</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Case</name>
        <label>Create Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Created_Case</targetReference>
        </connector>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>caseDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Origin</field>
            <value>
                <stringValue>Web</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>caseSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SuppliedEmail</field>
            <value>
                <elementReference>emailClean</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Created_Case</name>
        <label>Get Created Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Result</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Create_Case</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>CaseNumber</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Order</name>
        <label>Get Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Order_Verified</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Order_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>orderNumberClean</elementReference>
            </value>
        </filters>
        <filters>
            <field>Customer_Email__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>emailClean</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Store_Order__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Order_Number__c</queriedFields>
        <queriedFields>Item__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Inputs_Present</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>The number of the new return case. Blank when no case was opened.</description>
        <name>caseNumber</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>True only when a return case was opened. False means the order number and email did not match, and no case exists.</description>
        <name>created</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>The email address the customer gives. Must match the email on the order.</description>
        <name>customerEmail</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>The order number the customer wants to return, such as RO-1002.</description>
        <name>orderNumber</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Why the customer is returning the item, in their words.</description>
        <name>reason</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
