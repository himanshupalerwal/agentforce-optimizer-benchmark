<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Set_Days_Since_Delivery</name>
        <label>Set Days Since Delivery</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>daysSinceDelivery</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>daysSinceDeliveryCalc</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Order_Details</name>
        <label>Set Order Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>verified</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>status</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Order.Status__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>item</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Order.Item__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>finalSale</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Order.Final_Sale__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>deliveredDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Order.Delivered_Date__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>expectedDeliveryDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Order.Expected_Delivery_Date__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Has_Delivery_Date</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_Delivery_Date</name>
        <label>Has Delivery Date?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Delivered</defaultConnectorLabel>
        <rules>
            <name>Delivered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Order.Delivered_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Days_Since_Delivery</targetReference>
            </connector>
            <label>Delivered</label>
        </rules>
    </decisions>
    <decisions>
        <name>Inputs_Present</name>
        <label>Inputs Present?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Missing Input</defaultConnectorLabel>
        <rules>
            <name>Both_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inputsPresent</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Order</targetReference>
            </connector>
            <label>Both Present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Order_Verified</name>
        <label>Order Verified?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Verified</defaultConnectorLabel>
        <rules>
            <name>Order_Matches</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Order</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Order_Details</targetReference>
            </connector>
            <label>Order Matches</label>
        </rules>
    </decisions>
    <description>Looks up a store order for the agent. Returns the order details only when the order number and the email on the order both match. Otherwise returns verified = false and nothing else, so a wrong email and a missing order look the same. It does not decide whether a return is allowed.</description>
    <environments>Default</environments>
    <formulas>
        <name>daysSinceDeliveryCalc</name>
        <dataType>Number</dataType>
        <expression>TODAY() - {!Get_Order.Delivered_Date__c}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>emailClean</name>
        <dataType>String</dataType>
        <expression>TRIM({!customerEmail})</expression>
    </formulas>
    <formulas>
        <name>inputsPresent</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK(TRIM({!orderNumber}))) &amp;&amp; NOT(ISBLANK(TRIM({!customerEmail})))</expression>
    </formulas>
    <formulas>
        <name>orderNumberClean</name>
        <dataType>String</dataType>
        <expression>UPPER(TRIM({!orderNumber}))</expression>
    </formulas>
    <interviewLabel>Get Order Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Order Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Order</name>
        <label>Get Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Order_Verified</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Order_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>orderNumberClean</elementReference>
            </value>
        </filters>
        <filters>
            <field>Customer_Email__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>emailClean</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Store_Order__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Status__c</queriedFields>
        <queriedFields>Item__c</queriedFields>
        <queriedFields>Final_Sale__c</queriedFields>
        <queriedFields>Delivered_Date__c</queriedFields>
        <queriedFields>Expected_Delivery_Date__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Inputs_Present</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>The email address the customer gives. Must match the email on the order. Case and surrounding spaces are ignored.</description>
        <name>customerEmail</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Days since the order was delivered. Blank if it has not been delivered.</description>
        <name>daysSinceDelivery</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <description>The day the order was delivered. Blank if it has not been delivered.</description>
        <name>deliveredDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>The delivery date the customer was promised.</description>
        <name>expectedDeliveryDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>True if the item was sold as final sale.</description>
        <name>finalSale</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>The product on the order.</description>
        <name>item</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>The order number the customer gives, such as RO-1002.</description>
        <name>orderNumber</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>The order status: Processing, Shipped, Delivered, or Cancelled.</description>
        <name>status</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>True only when the order exists and the email matches. When false, every other output is blank and nothing about the order may be shared.</description>
        <name>verified</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>
